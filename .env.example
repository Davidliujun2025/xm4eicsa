# Shared local development environment template.
# Copy to .env locally if a tool or service needs it. Do not commit real secrets.

APP_ENV=local

# Local development connects to Tencent Cloud MySQL through an SSH tunnel.
# Start scripts/start-mysql-tunnel.sh first, then connect to 127.0.0.1:3307.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=xm4
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me

# Java/Spring Boot services can use MYSQL_URL directly.
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/xm4?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# DeepSeek intent recognition. Keep the real key only in the runtime environment.
DEEPSEEK_API_KEY=change_me
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_MAX_TOKENS=1400
AI_THINKING_ENABLED=false
AI_TIMEOUT_SECONDS=60

# Tencent Cloud server metadata. Keep passwords outside the repository.
TENCENT_CLOUD_HOST=42.193.201.236
TENCENT_CLOUD_SSH_PORT=22
TENCENT_CLOUD_SSH_USER=ubuntu
