# Example Nginx virtual host for Tencent Cloud deployment.
# Copy to /etc/nginx/sites-available/xm4eicsa or /etc/nginx/conf.d/xm4eicsa.conf on the server,
# then replace server_name and paths with real deployment values.

server {
    listen 80;
    server_name example.com 42.193.201.236;

    root /var/www/xm4eicsa;
    index index.html;

    client_max_body_size 50m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/chat/ {
        proxy_pass http://127.0.0.1:8081/api/chat/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/forbidden-words/ {
        proxy_pass http://127.0.0.1:8080/api/forbidden-words/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # TODO: Add these reverse proxies after feature owners confirm ports.
    # location /api/auth/ { proxy_pass http://127.0.0.1:<port>/api/auth/; }
    # location /api/password/ { proxy_pass http://127.0.0.1:<port>/api/password/; }
    # location /api/agents/ { proxy_pass http://127.0.0.1:<port>/api/agents/; }
    # location /api/scripts/ { proxy_pass http://127.0.0.1:<port>/api/scripts/; }
    # location /api/token-quota/ { proxy_pass http://127.0.0.1:<port>/api/token-quota/; }
    # location /api/token-usage/ { proxy_pass http://127.0.0.1:<port>/api/token-usage/; }
}