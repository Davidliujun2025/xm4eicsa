# Server
TOKEN_MONITOR_HOST=0.0.0.0
TOKEN_MONITOR_PORT=8080
TOKEN_MONITOR_ZONE=Asia/Shanghai
TOKEN_MONITOR_INTERNAL_API_KEY=change-me

# Personal daily quota policy. 0 means quota not configured; usage status becomes UNCONFIGURED.
TOKEN_MONITOR_DAILY_TOKEN_LIMIT=0
TOKEN_MONITOR_HIGH_USAGE_THRESHOLD=0.80
TOKEN_MONITOR_FAILURE_RATE_THRESHOLD=0.20

# Optional MySQL 8. Apply backend/db/V1__create_token_usage_event.sql first.
# UTC parameters keep Java Instant and MySQL DATETIME(6) consistent.
TOKEN_MONITOR_JDBC_URL=jdbc:mysql://REPLACE_WITH_XM4_HOST:3306/xm4?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true&enabledTLSProtocols=TLSv1.3&verifyServerCertificate=true
TOKEN_MONITOR_JDBC_USER=
TOKEN_MONITOR_JDBC_PASSWORD=

# Provider quota adapters. Never commit real keys.
KIMI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_TOKEN_PLAN_API_KEY=
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=
